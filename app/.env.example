# Kopier til .env og fyll inn.
SITE_TITLE=Eirik Dalhus
SITE_TAGLINE=Foto
# Første oppstart: admin-bruker opprettes fra disse hvis ingen finnes.
ADMIN_EMAIL=eirik@example.com
ADMIN_PASSWORD=bytt-meg
DATA_DIR=./data
# E-post med innloggingslenker til gjester. Uten SMTP_HOST skrives e-posten til loggen.
#SMTP_HOST=127.0.0.1
#SMTP_PORT=587
#MAIL_FROM=Ditt Navn <noreply@example.com>
# local = originaler på disk (STORAGE_LOCAL_DIR), s3 = S3-kompatibel lagring (f.eks. rclone serve s3 på en NAS, R2, MinIO)
STORAGE_DRIVER=local
#STORAGE_LOCAL_DIR=./data/store
#S3_ENDPOINT=http://nas.din-tailnet.ts.net:8099
#S3_REGION=us-east-1
#S3_ACCESS_KEY_ID=
#S3_SECRET_ACCESS_KEY=
#S3_BUCKET=originaler
#S3_BACKUP_BUCKET=database
